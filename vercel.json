{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node prepare_deploy.mjs",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "rewrites": [
    { "source": "/br/arrependimento", "destination": "/br/arrependimento/index.html" },
    { "source": "/br/arrependimento/", "destination": "/br/arrependimento/index.html" },
    { "source": "/br/((?!api(?:/|$)|.*\\.).*)", "destination": "/br/index.html" },
    { "source": "/recesso", "destination": "/recesso/index.html" },
    { "source": "/recesso/", "destination": "/recesso/index.html" },
    { "source": "/((?!api(?:/|$)|br(?:/|$)|.*\\.).*)", "destination": "/index.html" }
  ]
}
